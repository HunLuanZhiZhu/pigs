      "content": "1\t//! Spawn tool — creates one or more sub-agents from a single tool call.\n2\t//!\n3\t//! The main agent calls this tool to delegate tasks to sub-agents.\n4\t//! Sub-agents can be:\n5\t//! - \"general\" (default): fully equivalent to the main agent\n6\t//! - Custom types: loaded from ~/.pig/agents/*.md or .pig/agents/*.md\n7\t//!\n8\t//! Custom agent types are defined as Markdown files with YAML frontmatter,\n9\t//! inspired by OpenCode's agent system.\n10\t\n11\tuse std::sync::Arc;\n12\t\n13\tuse pigs_core::{ToolFuture, ToolHandler, ToolResult, ToolSpec};\n14\tuse serde_json::json;\n15\t\n16\tuse crate::sub_agent::{SubAgentManager, SubAgentMode};\n17\t\n18\t/// Tool that spawns sub-agents.\n19\tpub struct SpawnTool {\n20\t    /// Shared sub-agent manager.\n21\t    pub manager: Arc<std::sync::Mutex<SubAgentManager>>,\n22\t    /// Model name for sub-agent sessions (used when agent type has no model override).\n23\t    pub model: String,\n24\t    /// Available custom agent definitions (loaded at startup).\n25\t    pub definitions: Vec<pigs_config::sub_agent_def::SubAgentDefinition>,\n26\t    /// Sessions directory for persisting sub-agent sessions.\n27\t    pub sessions_dir: std::path::PathBuf,\n28\t}\n29\t\n30\timpl SpawnTool {\n31\t    pub fn new(\n32\t        manager: Arc<std::sync::Mutex<SubAgentManager>>,\n33\t        model: String,\n34\t        definitions: Vec<pigs_config::sub_agent_def::SubAgentDefinition>,\n35\t        sessions_dir: std::path::PathBuf,\n36\t    ) -> Self {\n37\t        Self {\n38\t            manager,\n39\t            model,\n40\t            definitions,\n41\t            sessions_dir,\n42\t        }\n43\t    }\n44\t\n45\t    /// Get the description of all available agent types for the LLM.\n46\t    fn agent_types_description(&self) -> String {\n47\t        let mut desc = String::from(\"\\n\\nAvailable agent types:\\n\");\n48\t        desc.push_str(\"- general: Full-featured agent with all tools (default)\\n\");\n49\t        for def in &self.definitions {\n50\t            desc.push_str(&format!(\"{}\\n\", def.description_for_llm()));\n51\t        }\n52\t        desc\n53\t    }\n54\t}\n55\t\n56\timpl ToolHandler for SpawnTool {\n57\t    fn name(&self) -> &str {\n58\t        \"spawn\"\n59\t    }\n60\t",
