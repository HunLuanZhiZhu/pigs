      "content": "1\t//! pigs-proxy — 多协议 HTTP 代理 + 相位化 Agent 路由器。\n2\t//! pigs-proxy — Multi-protocol HTTP proxy + phased agent router.\n3\t//!\n4\t//! 从 mini-proxy 演化而来，作为 pigs 项目的**前置路由层**。\n5\t//! Evolved from mini-proxy, serving as the **front router** for the pigs project.\n6\t//!\n7\t//! 核心职责 / Core responsibilities:\n8\t//! 1. 监听单一端口（默认 3927），接收三种协议的请求：\n9\t//!    Listens on a single port (default 3927), accepting three protocols:\n10\t//!    - `/chat/completions` — OpenAI Chat\n11\t//!    - `/v1/messages` — Anthropic Messages\n12\t//!    - `/responses` — OpenAI Responses\n13\t//! 2. 按 model ID 路由：\n14\t//!    Routes by model ID:\n15\t//!    - 无 `-pig` 后缀 → 透传到上游 LLM（原始代理逻辑）\n16\t//!      No `-pig` suffix → passthrough to upstream LLM (original proxy logic)\n17\t//!    - 有 `-pig` 后缀 → 转给 pigs-api 相位运行时（Pre→Executor→Post）\n18\t//!      Has `-pig` suffix → route to pigs-api phased runtime (Pre→Executor→Post)\n19\t//! 3. `/v1/models` 返回 ×2 模型列表（每个模型 + 其 `-pig` 版本）\n20\t//!    `/v1/models` returns ×2 model list (each model + its `-pig` variant)\n21\t\n22\tpub mod compaction;\n23\tpub mod config;\n24\tpub mod log;\n25\tpub mod loopback;\n26\tpub mod protocol;\n27\tpub mod proxy_client;\n28\tpub mod retry;\n29\tpub mod server;\n30\tpub mod upstream;\n31\t\n32\tuse std::net::SocketAddr;\n33\tuse std::sync::Arc;\n34\t\n35\tuse axum::http::HeaderMap;\n36\tuse serde_json::Value;\n37\t\n38\t// Task-local storage retained for the CLI in-process transport.\n39\t// HTTP `-pig` requests use LoopbackPhaseTransport and carry their full header set\n40\t// through the native request envelope instead of using this task-local.\n41\ttokio::task_local! {\n42\t    /// 当前请求的客户端头（仅含 auth 相关头）。\n43\t    /// The current request's client headers (auth-related only).\n44\t    pub static CLIENT_HEADERS: HeaderMap;\n45\t}\n46\t\n47\t/// 在 task-local 上下文中执行异步函数，注入客户端头。\n48\t/// Run an async function within a task-local context that injects client headers.\n49\t///\n50\t/// Compatibility helper for callers of the CLI in-process transport.\n51\t/// HTTP phase requests do not use this function.\n52\tpub async fn with_client_headers<F, R>(headers: HeaderMap, f: F) -> R\n53\twhere\n54\t    F: std::future::Future<Output = R>,\n55\t{\n56\t    // 只保留 auth 相关的头，避免泄露无关信息\n57\t    // Keep only auth-related headers to avoid leaking unrelated info\n58\t    let auth_headers: HeaderMap = headers\n59\t        .iter()\n60\t        .filter(|(name, _)| {\n61\t            let lower = name.as_str().to_lowercase();\n62\t            lower == \"authorization\" || lower == \"x-api-key\" || lower == \"anthropic-version\"\n63\t        })\n64\t        .map(|(name, value)| (name.clone(), value.clone()))\n65\t        .collect();\n66\t    CLIENT_HEADERS.scope(auth_headers, f).await\n67\t}\n68\t\n69\t/// 获取当前 task-local 中的客户端头（如有）。\n70\t/// Get the client headers from task-local (if any).\n71\t///\n72\t/// `dispatch_in_process` 调用此函数获取 auth 头。\n73\t/// 如果不在 task-local 上下文中（如 CLI 直接调用），返回空 `HeaderMap`。\n74\t///\n75\t/// `dispatch_in_process` calls this to get auth headers.\n76\t/// Returns an empty `HeaderMap` if not in a task-local context (e.g. CLI).\n77\tpub fn current_client_headers() -> HeaderMap {\n78\t    CLIENT_HEADERS.try_with(|h| h.clone()).unwrap_or_default()\n79\t}\n80\t\n81\t/// 从 pigs-proxy 配置构建 PhasedRuntime（通过 ProxyApiClient 走 pigs-proxy 重试）。\n82\t///\n83\t/// Build a PhasedRuntime from pigs-proxy config (via ProxyApiClient through pigs-proxy retry).\n84\t///\n85\t/// LLM 请求不直接连上游，而是通过 `dispatch_in_process` 走代理重试逻辑。\n86\t/// LLM requests don't connect to upstream directly; instead they go through\n87\t/// `dispatch_in_process` for proxy retry logic.\n88\tpub fn build_phased_runtime(\n89\t    proxy_config: Arc<config::Config>,\n90\t    model: &str,\n91\t    language: pigs_config::Language,\n92\t    limits: pigs_api::phased_runtime::RuntimeLimits,\n93\t) -> anyhow::Result<pigs_api::phased_runtime::PhasedRuntime> {\n94\t    use pigs_api::phased_tools::info_tool_registry;\n95\t    use pigs_core::ApiClient;\n96\t\n97\t    // 默认用 OpenAI Chat 协议 / Default to OpenAI Chat protocol\n98\t    let protocol = protocol::Protocol::OpenAI;\n99\t    let api: Arc<dyn ApiClient> = Arc::new(proxy_client::ProxyApiClient::new(\n100\t        proxy_config,\n101\t        protocol,\n102\t        model.to_string(),\n103\t    ));\n104\t    let wrapped_model = format!(\"{}-pig\", model);\n105\t    Ok(pigs_api::phased_runtime::PhasedRuntime {\n106\t        api,\n107\t        remote_model: model.to_string(),\n108\t        wrapped_model,\n109\t        tools: info_tool_registry(),\n110\t        limits,\n111\t        language,\n112\t        is_pig: true,\n113\t    })\n114\t}\n115\t\n116\t/// 进程内调度请求（不经过 HTTP，直接走重试逻辑）。\n117\t///\n118\t/// In-process request dispatch (bypasses HTTP, goes straight to retry logic).\n119\t///\n120\t/// Used by the CLI-compatible `ProxyApiClient`; HTTP phase subrequests use\n121\t/// `LoopbackPhaseTransport` instead.\n122\t///\n123\t/// # 参数 / Parameters\n124\t/// - `config`: 代理配置\n125\t/// - `client`: 上游 HTTP 客户端\n126\t/// - `protocol`: 请求协议（决定上游 URL 后缀）\n127\t/// - `model`: 模型 ID（不含 `-pig` 后缀，用于端点匹配）\n128\t/// - `body`: 请求体 JSON（包含 messages/tools/temperature 等）\n129\t///\n130\t/// # 返回 / Returns\n131\t/// - `Ok(Value)`: 上游响应体 JSON\n132\t/// - `Err(String)`: 错误描述\n133\tpub async fn dispatch_in_process(\n134\t    config: &config::Config,\n135\t    client: &upstream::UpstreamClient,\n136\t    protocol: protocol::Protocol,\n137\t    model: &str,\n138\t    body: &Value,\n139\t) -> Result<Value, String> {\n140\t    // 查找匹配的端点 / Find matching endpoint\n141\t    let endpoint = match server::pick_endpoint(config, protocol, model) {\n142\t        Some(ep) => ep,\n143\t        None => {\n144\t            return Err(format!(\n145\t                \"no matching endpoint for protocol {:?} model {}\",\n146\t                protocol, model\n147\t            ));\n148\t        }\n149\t    };\n150\t\n151\t    // 克隆 body 做可变处理 / Clone body for mutation\n152\t    let mut parsed = body.clone();\n153\t\n154\t    // 模型名映射 / Model name mapping\n155\t    let upstream_model = endpoint.map_model(model);\n156\t    if upstream_model != model {\n157\t        if let Some(obj) = parsed.as_object_mut() {\n158\t            obj.insert(\"model\".into(), Value::String(upstream_model.clone()));\n159\t        }\n160\t    }\n161\t\n162\t    // 清洗空 content 项 / Clean empty-content messages\n163\t    if config.server.clean_empty_content {\n164\t        server::clean_empty_messages(&mut parsed, protocol);\n165\t    }\n166\t\n167\t    // 思考强度注入 / Thinking-effort injection\n168\t    let effort = endpoint\n169\t        .thinking_effort\n170\t        .clone()\n171\t        .unwrap_or_else(|| protocol.default_effort().to_string());\n172\t    server::inject_thinking(&mut parsed, protocol, &effort);\n173\t\n174\t    // 序列化处理后的 body / Serialize processed body\n175\t    let body_bytes = bytes::Bytes::from(\n176\t        serde_json::to_vec(&parsed)\n177\t            .unwrap_or_else(|_| serde_json::to_vec(body).unwrap_or_default()),\n178\t    );\n179\t\n180\t    // 从 task-local 获取客户端 auth 头（-pig HTTP 路径注入）；\n181\t    // 如果不在 task-local 上下文中（如 CLI 直接调用），返回空。\n182\t    // Get client auth headers from task-local (injected by -pig HTTP path);\n183\t    // returns empty if not in a task-local context (e.g. CLI direct call).\n184\t    let headers = current_client_headers();\n185\t\n186\t    // 走重试调度 / Go through retry dispatch\n187\t    let outcome = retry::dispatch(client, &endpoint, protocol, &body_bytes, &headers).await;\n188\t\n189\t    match outcome {\n190\t        retry::DispatchOutcome::Ok(resp) => {\n191\t            // 读取响应 body / Read response body\n192\t            use axum::body::to_bytes;\n193\t            let bytes = to_bytes(resp.into_body(), 1024 * 1024 * 10)\n194\t                .await\n195\t                .map_err(|e| format!(\"failed to read response body: {e}\"))?;\n196\t            serde_json::from_slice::<Value>(&bytes)\n197\t                .map_err(|e| format!(\"failed to parse response JSON: {e}\"))\n198\t        }\n199\t        retry::DispatchOutcome::Failed { status, body } => Err(format!(\n200\t            \"upstream failed with status {}: {}\",\n201\t            status,\n202\t            String::from_utf8_lossy(&body)\n203\t        )),\n204\t    }\n205\t}\n206\t\n207\tuse anyhow::Result;\n208\tuse tracing::info;\n209\t\n210\t/// 启动 HTTP 代理服务器。\n211\t///\n212\t/// Start the HTTP proxy server.\n213\t///\n214\t/// # 参数 / Parameters\n215\t/// - `config`: 代理配置（含 provider/endpoint/日志等）\n216\t///   Proxy configuration (providers, endpoints, logging, etc.)\n217\tpub async fn serve(config: config::Config) -> Result<()> {\n218\t    // 注意：日志初始化由调用方负责，避免与 pigs-cli 的 init_logging 冲突。\n219\t    // Logging initialization is the caller's responsibility, to avoid\n220\t    // conflicting with pigs-cli's init_logging (\"global default subscriber already set\").\n221\t    tracing::info!(\"配置加载完成\");\n222\t\n223\t    // 启动时打印渠道信息 / Print provider info at startup\n224\t    for p in &config.provider {\n225\t        if let Some(ep) = p.openai_endpoint() {\n226\t            info!(\n227\t                provider = %p.name,\n228\t                protocol = \"openai\",\n229\t                base_url = %ep.base_url,\n230\t                models = ?ep.models,\n231\t                max_retries = ep.max_retries,\n232\t                key_mode = ?ep.key_mode,\n233\t                \"已加载渠道\"\n234\t            );\n235\t        }\n236\t        if let Some(ep) = p.anthropic_endpoint() {\n237\t            info!(\n238\t                provider = %p.name,\n239\t                protocol = \"anthropic\",\n240\t                base_url = %ep.base_url,\n241\t                models = ?ep.models,\n242\t                max_retries = ep.max_retries,\n243\t                key_mode = ?ep.key_mode,\n244\t                \"已加载渠道\"\n245\t            );\n246\t        }\n247\t        if let Some(ep) = p.responses_endpoint() {\n248\t            info!(\n249\t                provider = %p.name,\n250\t                protocol = \"responses\",\n251\t                base_url = %ep.base_url,\n252\t                models = ?ep.models,\n253\t                max_retries = ep.max_retries,\n254\t                key_mode = ?ep.key_mode,\n255\t                \"已加载渠道\"\n256\t            );\n257\t        }\n258\t    }\n259\t\n260\t    let listen = config.server.listen.clone();\n261\t    let addr: SocketAddr = listen\n262\t        .parse()\n263\t        .map_err(|e| anyhow::anyhow!(\"invalid listen address {listen}: {e}\"))?;\n264\t    let internal_phase_token = uuid::Uuid::new_v4().to_string();\n265\t    let transport = Arc::new(\n266\t        loopback::LoopbackPhaseTransport::new(addr, internal_phase_token.clone())\n267\t            .map_err(|error| anyhow::anyhow!(error.to_string()))?,\n268\t    );\n269\t    let runtime = pigs_api::http_runtime::HttpPhasedRuntime::new(\n270\t        transport,\n271\t        pigs_api::http_runtime::HttpRuntimeConfig {\n272\t            language: config\n273\t                .language\n274\t                .parse::<pigs_config::Language>()\n275\t                .unwrap_or_default(),\n276\t            orchestration: pigs_api::orchestration::OrchestrationLimits::default(),\n277\t            continuation: pigs_api::continuation::ContinuationConfig::default(),\n278\t        },\n279\t    );\n280\t    let client = Arc::new(upstream::UpstreamClient::new());\n281\t    let loopback_base_url = format!(\"http://{}\", addr);\n282\t    let state = server::AppState {\n283\t        config: Arc::new(config.clone()),\n284\t        client,\n285\t        runtime: Arc::new(runtime),\n286\t        internal_phase_token: Arc::from(internal_phase_token),\n287\t        compaction_cache: Arc::new(std::sync::Mutex::new(\n288\t            crate::compaction::CompactionCache::new(),\n289\t        )),\n290\t        loopback_base_url,\n291\t    };\n292\t    let app = server::build(state);\n293\t\n294\t    eprintln!();\n295\t    eprintln!(\"═══════════════════════════════════════════════════════════\");\n296\t    eprintln!(\"  pigs-proxy 已启动，监听 {}\", listen);\n297\t    eprintln!();\n298\t    eprintln!(\"  对外服务端点：\");\n299\t    eprintln!(\n300\t        \"      POST http://{}/chat/completions  → OpenAI 协议\",\n301\t        listen\n302\t    );\n303\t    eprintln!(\n304\t        \"      POST http://{}/v1/messages       → Anthropic 协议\",\n305\t        listen\n306\t    );\n307\t    eprintln!(\n308\t        \"      POST http://{}/responses         → Response 协议\",\n309\t        listen\n310\t    );\n311\t    eprintln!(\n312\t        \"      GET  http://{}/v1/models         → 模型列表（×2）\",\n313\t        listen\n314\t    );\n315\t    eprintln!();\n316\t    eprintln!(\"  model ID 无 -pig 后缀 → 透传上游\");\n317\t    eprintln!(\"  model ID 有 -pig 后缀 → 相位化运行时（Pre→Executor→Post）\");\n318\t    eprintln!(\"═══════════════════════════════════════════════════════════\");\n319\t\n320\t    let listener = tokio::net::TcpListener::bind(addr).await?;\n321\t    info!(listen = %listen, \"服务启动完成\");\n322\t    axum::serve(listener, app).await?;\n323\t    Ok(())\n324\t}\n325\t",
      "role": "tool",
      "tool_call_id": "call_7c80c751a29c447093e54d18"
    },
    {
      "content": "1\t//! Pigs CLI library — the complete local agent / REPL.\n2\t//!\n3\t//! This crate is a **library** (not a binary). The product binary `pigs`\n4\t//! imports it for `--cli` mode. All agent, REPL, slash-command, MCP, hooks,\n5\t//! doctor, i18n, and session logic lives here.\n6\t\n7\tpub mod agent;\n8\tpub mod cli;\n9\tpub mod command_aliases;\n10\tpub mod commands;\n11\tpub mod doctor;\n12\tpub mod hooks;\n13\tpub mod http_client;\n14\tpub mod i18n;\n15\tpub mod models;\n16\tpub mod output;\n17\tpub mod repl;\n18\tpub mod skill_tool;\n19\tpub mod snapshots;\n20\tpub mod sub_agent;\n21\tpub mod sub_agent_tool;\n22\tpub mod tui_repl;\n23\t\n24\t// 相位模块已移至 pigs-api crate；此处 re-export 保持旧路径可用。\n25\t// Phased modules moved to pigs-api crate; re-export keeps old paths working.\n26\tpub use pigs_api::phased_api_convert;\n27\tpub use pigs_api::phased_markers;\n28\tpub use pigs_api::phased_phase;\n29\tpub use pigs_api::phased_prompts;\n30\tpub use pigs_api::phased_runtime;\n31\tpub use pigs_api::phased_tools;\n32\t\n33\tuse std::process::ExitCode;\n34\tuse std::sync::Arc;\n35\t\n36\tuse clap::Parser;\n37\tuse tracing_subscriber::{fmt, layer::SubscriberExt, util::SubscriberInitExt, EnvFilter};\n38\t\n39\t/// Run the full pigs-cli agent (REPL or one-shot).\n40\t///\n41\t/// Called by `pigs --cli` — the product binary delegates here instead of\n42\t/// implementing its own CLI logic. Reads args from `std::env::args()`.\n43\tpub async fn run_cli() -> ExitCode {\n44\t    match run().await {\n45\t        Ok(()) => ExitCode::SUCCESS,\n46\t        Err(e) => {\n47\t            eprintln!(\"Error: {e:#}\");\n48\t            ExitCode::FAILURE\n49\t        }\n50\t    }\n51\t}\n52\t\n53\t/// Like [`run_cli`] but with explicit args (for forwarding from `pigs --cli`).\n54\t///\n55\t/// `args` should include the program name as the first element (e.g.\n56\t/// `[\"pigs\", \"--list-sessions\"]`).\n57\tpub async fn run_cli_from(args: Vec<String>) -> ExitCode {\n58\t    match run_from(&args, None).await {\n59\t        Ok(()) => ExitCode::SUCCESS,\n60\t        Err(e) => {\n61\t            eprintln!(\"Error: {e:#}\");\n62\t            ExitCode::FAILURE\n63\t        }\n64\t    }\n65\t}\n66\t\n67\t/// Like [`run_cli_from`] but with an injected `ApiClient`.\n68\t///\n69\t/// 当 `api_client` 为 `Some` 时，Agent 使用它代替内部创建的 `pigs-llm` 直连客户端。\n70\t/// `pigs` 二进制借此将 CLI 的 LLM 请求统一经过 `pigs-proxy` 的\n71\t/// `ProxyApiClient` → `dispatch_in_process` 重试逻辑。\n72\t///\n73\t/// When `api_client` is `Some`, the agent uses it instead of building its own\n74\t/// direct `pigs-llm` client. The `pigs` binary uses this to route CLI LLM\n75\t/// requests through `pigs-proxy`'s `ProxyApiClient` → `dispatch_in_process`.\n76\tpub async fn run_cli_with_client(\n77\t    args: Vec<String>,\n78\t    api_client: Option<Arc<dyn pigs_core::ApiClient>>,\n79\t) -> ExitCode {\n80\t    match run_from(&args, api_client).await {\n81\t        Ok(()) => ExitCode::SUCCESS,\n82\t        Err(e) => {\n83\t            eprintln!(\"Error: {e:#}\");\n84\t            ExitCode::FAILURE\n85\t        }\n86\t    }\n87\t}\n88\t\n89\t/// Like [`run_cli_from`] but connects to the local API server over HTTP.\n90\t///\n91\t/// The agent uses `HttpAgentClient` to send LLM requests to\n92\t/// `http://{host}:{port}/chat/completions` with real SSE streaming.\n93\t/// The model name sent is the real (non-`-pig`) model name, so the API\n94\t/// server routes it through passthrough; `PhasedRuntime` inside the agent\n95\t/// does Pre→Executor→Post orchestration locally.\n96\tpub async fn run_cli_with_http(args: Vec<String>, host: String, port: u16) -> ExitCode {\n97\t    match run_from_http(&args, &host, port, None).await {\n98\t        Ok(()) => ExitCode::SUCCESS,\n99\t        Err(e) => {\n100\t            eprintln!(\"Error: {e:#}\");\n101\t            ExitCode::FAILURE\n102\t        }\n103\t    }\n104\t}\n105\t\n106\t/// Like `run_cli_with_http` but also receives proxy log lines for TUI display.\n107\t/// The log receiver is passed to the TUI which renders it as a virtual \"api\" session.\n108\tpub async fn run_cli_with_http_and_log(\n109\t    args: Vec<String>,\n110\t    host: String,\n111\t    port: u16,\n112\t    log_rx: tokio::sync::mpsc::UnboundedReceiver<String>,\n113\t) -> ExitCode {\n114\t    match run_from_http(&args, &host, port, Some(log_rx)).await {\n115\t        Ok(()) => ExitCode::SUCCESS,\n116\t        Err(e) => {\n117\t            eprintln!(\"Error: {e:#}\");\n118\t            ExitCode::FAILURE\n119\t        }\n120\t    }\n121\t}\n122\t\n123\tasync fn run_from_http(\n124\t    args: &[String],\n125\t    host: &str,\n126\t    port: u16,\n127\t    log_rx: Option<tokio::sync::mpsc::UnboundedReceiver<String>>,\n128\t) -> anyhow::Result<()> {\n129\t    let parsed = clap::Parser::parse_from(args.iter().map(|s| s.as_str()));\n130\t    run_with_http(parsed, host, port, log_rx).await\n131\t}\n132\t\n133\tasync fn run_with_http(\n134\t    args: cli::CliArgs,\n135\t    host: &str,\n136\t    port: u16,\n137\t    log_rx: Option<tokio::sync::mpsc::UnboundedReceiver<String>>,\n138\t) -> anyhow::Result<()> {\n139\t    if args.list_sessions {\n140\t        let sessions = agent::Agent::list_sessions()?;\n141\t        if sessions.is_empty() {\n142\t            println!(\"No saved sessions.\");\n143\t        } else {\n144\t            println!(\n145\t                \"{:<10} {:<6} {:<28} {:<18} {:<6} {:<16}\",\n146\t                \"Code\", \"Type\", \"Title\", \"Model\", \"Msgs\", \"Updated\"\n147\t            );\n148\t            println!(\"{}\", \"-\".repeat(90));\n149\t            for s in sessions.iter().take(20) {\n150\t                let updated = s.updated_at.format(\"%Y-%m-%d %H:%M\");\n151\t                let title = s.title.clone().unwrap_or_else(|| \"(untitled)\".to_string());\n152\t                let title = if title.chars().count() > 26 {\n153\t                    let t: String = title.chars().take(23).collect();\n154\t                    format!(\"{t}...\")\n155\t                } else {\n156\t                    title\n157\t                };\n158\t                let agent_type = if s.agent_type.is_empty() { \"?\" } else { &s.agent_type };\n159\t                println!(\n160\t                    \"{:<10} {:<6} {title:<28} {:<18} {:<6} {updated}\",\n161\t                    s.session_id, agent_type, s.model, s.message_count\n162\t                );\n163\t            }\n164\t        }\n165\t        return Ok(());\n166\t    }\n167\t\n168\t    pigs_config::AppConfig::ensure_config_dir().map_err(|e| anyhow::anyhow!(e.to_string()))?;\n169\t\n170\t    let workspace = std::env::current_dir().unwrap_or_else(|_| std::path::PathBuf::from(\".\"));\n171\t    let config = pigs_config::AppConfig::load_layered(&workspace)\n172\t        .map_err(|e| anyhow::anyhow!(e.to_string()))?\n173\t        .with_env_overrides();\n174\t\n175\t    let _log_guard = init_logging(&config)?;\n176\t\n177\t    let mut agent = agent::Agent::new_with_http(config, args, host, port)?;\n178\t    agent.connect_configured_mcp().await?;\n179\t\n180\t    if let Some(prompt) = agent.one_shot_prompt.clone() {\n181\t        let text = agent.run_turn(&prompt).await?;\n182\t        if agent.output_format.eq_ignore_ascii_case(\"json\") {\n183\t            let payload = serde_json::json!({\n184\t                \"session_id\": agent.session.session_id,\n185\t                \"title\": agent.session.display_title(),\n186\t                \"model\": agent.session.model,\n187\t                \"output\": text,\n188\t            });\n189\t            println!(\"{}\", serde_json::to_string_pretty(&payload)?);\n190\t        }\n191\t        agent.session.save(&agent.sessions_dir)?;\n192\t        return Ok(());\n193\t    }\n194\t\n195\t    // Use TUI by default (aligned with PI's full-screen interactive mode).\n196\t    // Falls back to rustyline REPL if TUI initialization fails.\n197\t    match crate::tui_repl::run_tui_repl(&mut agent, log_rx).await {\n198\t        