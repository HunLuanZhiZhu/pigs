      "content": "1\t//! Sub-agent system — enables the main agent to spawn child agents.\n2\t//!\n3\t//! pigs = pig (phased orchestration) + s (free sub-agents).\n4\t//!\n5\t//! Sub-agents are fully equivalent to the main agent: same tools, same model,\n6\t//! same pig phased orchestration. They can recursively create their own\n7\t//! sub-agents. The TUI can switch between viewing the main agent's conversation\n8\t//! and any sub-agent's conversation via `/sub <id>`.\n9\t\n10\tuse std::collections::HashMap;\n11\tuse tokio::sync::mpsc;\n12\t\n13\tuse pigs_core::Message;\n14\tuse pigs_session::Session;\n15\t\n16\t/// Sub-agent execution mode.\n17\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n18\tpub enum SubAgentMode {\n19\t    /// Main agent waits for the sub-agent to finish, then uses the result.\n20\t    Foreground,\n21\t    /// Main agent does NOT wait; sub-agent runs asynchronously and\n22\t    /// notifies the main agent upon completion.\n23\t    Background,\n24\t}\n25\t\n26\timpl SubAgentMode {\n27\t    pub fn as_str(&self) -> &'static str {\n28\t        match self {\n29\t            Self::Foreground => \"foreground\",\n30\t            Self::Background => \"background\",\n31\t        }\n32\t    }\n33\t}\n34\t\n35\t/// Sub-agent execution status.\n36\t#[derive(Debug, Clone, PartialEq)]\n37\tpub enum SubAgentStatus {\n38\t    /// Created but not yet started.\n39\t    Pending,\n40\t    /// Currently running.\n41\t    Running,\n42\t    /// Completed successfully.\n43\t    Done,\n44\t    /// Failed with an error message.\n45\t    Error(String),\n46\t}\n47\t\n48\timpl SubAgentStatus {\n49\t    pub fn is_terminal(&self) -> bool {\n50\t        matches!(self, Self::Done | Self::Error(_))\n51\t    }\n52\t\n53\t    pub fn display(&self) -> String {\n54\t        match self {\n55\t            Self::Pending => \"pending\".to_string(),\n56\t            Self::Running => \"running\".to_string(),\n57\t            Self::Done => \"✓ done\".to_string(),\n58\t            Self::Error(e) => format!(\"✗ error: {e}\"),\n59\t        }\n60\t    }\n61\t}\n62\t\n63\t/// A single sub-agent record.\n64\t#[derive(Debug, Clone)]\n65\tpub struct SubAgent {\n66\t    /// Unique ID (e.g. \"sub-001\").\n67\t    pub id: String,\n68\t    /// Task description given to the sub-agent.\n69\t    pub task: String,\n70\t    /// Execution mode.\n71\t    pub mode: SubAgentMode,\n72\t    /// Current status.\n73\t    pub status: SubAgentStatus,\n74\t    /// The sub-agent's own session (optionally shared from parent).\n75\t    pub session: Session,\n76\t    /// Result text (set when status becomes Done).\n77\t    pub result: Option<String>,\n78\t    /// Parent agent ID (\"main\" or another sub-agent's ID).\n79\t    pub parent_id: String,\n80\t    /// Child sub-agent IDs (for recursive spawning).",
