              "type": "string"
            },
            "summary": {
              "description": "Short summary of the message for logs and model-visible delivery status.",
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "to": {
              "description": "Target local agent id, such as agent_<uuid>.",
              "maxLength": 200,
