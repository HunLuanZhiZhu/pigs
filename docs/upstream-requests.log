    {
      "content": "1\t// =============================================================================\n2\t// pigs crate — 唯一产品二进制入口\n3\t// Unique product binary entry point for the Pigs phased agent runtime.\n4\t// =============================================================================\n5\t//\n6\t// 本 crate 是整个 pigs 项目的顶层二进制 crate。\n7\t// This crate is the top-level binary crate for the whole pigs project.\n8\t//\n9\t// 运行模式 / Run modes:\n10\t//   - 默认（无参数）：启动相位 HTTP API（后台）+ CLI REPL（前台，走 HTTP 端口）\n11\t//     Default (no args): starts phased HTTP API (background) + CLI REPL (foreground, over HTTP)\n12\t//   - --api：仅 API，纯后台守护进程 / --api: API-only, pure background daemon\n13\t//   - \"prompt\"：启动 API + 一次性 CLI 对话（走 HTTP 端口）\n14\t//     \"prompt\": starts API + one-shot CLI turn (over HTTP)\n15\t//\n16\t// CLI 始终通过 HTTP 端口与 API 服务器交互，获得真流式 SSE 输出。\n17\t// The CLI always connects to the API server over HTTP, getting real SSE streaming.\n18\t//\n19\t// 设计文档：crates/pigs/docs/理解与规划.md\n20\t// Design doc: crates/pigs/docs/理解与规划.md\n21\t\n22\tuse std::path::PathBuf;\n23\t\n24\tuse clap::Parser;\n25\t\n26\tuse pigs_proxy::config::Config as ProxyConfig;\n27\t\n28\t/// pigs 命令行参数。\n29\t/// Pigs CLI arguments, parsed via the clap derive macro.\n30\t///\n31\t/// flags: --api, --describe\n32\t/// options: --host (默认 127.0.0.1), --port (默认 3927)\n33\t/// positional: [PROMPT] (可选 / optional)\n34\t/// trailing: -- (转发到 pigs-cli 的所有剩余参数 / all remaining args forwarded to pigs-cli)\n35\t#[derive(Parser, Debug)]\n36\t#[command(\n37\t    name = \"pigs\",\n38\t    version,\n39\t    about = \"Pigs: CLI + phased agent API in one process\",\n40\t    long_about = \"Default (no args): starts a background phased HTTP API on 127.0.0.1:3927 \\\n41\tand opens the interactive pigs-cli REPL connected via HTTP.\\n\\\n42\t`pigs --api` runs API-only (no REPL, pure background).\\n\\\n43\t`pigs \\\"prompt\\\"` starts API + runs a one-shot CLI turn over HTTP.\\n\\\n44\tDesign: crates/pigs/docs/理解与规划.md\"\n45\t)]\n46\tstruct Args {\n47\t    /// --api 标志：仅 API 模式。\n48\t    /// 启动相位 HTTP API 服务器作为后台守护进程，不启动 CLI。\n49\t    /// --api flag: API-only mode.\n50\t    /// Starts the phased HTTP API as a background daemon, no CLI.\n51\t    #[arg(long)]\n52\t    api: bool,\n53\t\n54\t    /// --describe 标志：打印运行时身份摘要并退出。\n55\t    /// --describe flag: print runtime identity summary and exit.\n56\t    #[arg(long)]\n57\t    describe: bool,\n58\t\n59\t    /// --host：本地 API 绑定地址（默认 loopback 127.0.0.1）。\n60\t    /// --host: local API bind address (default loopback 127.0.0.1).\n61\t    #[arg(long, default_value = \"127.0.0.1\")]\n62\t    host: String,\n63\t\n64\t    /// --port：本地 API 绑定端口（默认 3927）。\n65\t    /// --port: local API bind port (default 3927).\n66\t    #[arg(long, default_value_t = 3927)]\n67\t    port: u16,\n68\t\n69\t    /// 可选的一次性提示词。\n70\t    /// 提供时进入一次性模式：启动 API + 跑一轮 CLI 对话后退出。\n71\t    /// Optional one-shot prompt string.\n72\t    /// When provided, starts API + runs a single CLI turn then exits.\n73\t    #[arg(value_name = \"PROMPT\")]\n74\t    prompt: Option<String>,\n75\t\n76\t    /// -- 之后的剩余参数，转发给 pigs-cli。\n77\t    /// Trailing arguments after `--`, forwarded to pigs-cli.\n78\t    /// E.g. --model, --mode, --resume, etc.\n79\t    #[arg(trailing_var_arg = true, allow_hyphen_values = true)]\n80\t    cli_args: Vec<String>,\n81\t}\n82\t\n83\t#[tokio::main]\n84\tasync fn main() -> anyhow::Result<()> {\n85\t    let args = Args::parse();\n86\t\n87\t    // --- --describe 模式 ---\n88\t    if args.describe {\n89\t        print_describe();\n90\t        return Ok(());\n91\t    }\n92\t\n93\t    // --- --api 模式：仅 API 服务器（后台守护进程） ---\n94\t    if args.api {\n95\t        return run_api_only(&args).await;\n96\t    }\n97\t\n98\t    // --- 默认 / 一次性 prompt 模式：API（后台）+ CLI（前台，走 HTTP） ---\n99\t    run_api_and_cli(&args).await\n100\t}\n101\t\n102\t/// 启动 API 服务器（后台）+ CLI REPL（前台，通过 HTTP 连接）。\n103\t///\n104\t/// Starts the API server (background) + CLI REPL (foreground, over HTTP).\n105\tasync fn run_api_and_cli(args: &Args) -> anyhow::Result<()> {\n106\t    // 加载 pigs-proxy 配置（分层：~/.pigs/config.toml → .pigs/config.toml → .pigs/config.local.toml）\n107\t    let workspace = std::env::current_dir().unwrap_or_else(|_| PathBuf::from(\".\"));\n108\t    let proxy_config = ProxyConfig::load_layered(&workspace)\n109\t        .map_err(|e| anyhow::anyhow!(e.to_string()))?;\n110\t\n111\t    // 普通模式：proxy 日志不输出到终端，通过 channel 桥接到 TUI（可在 /ses api 中查看）\n112\t    let (log_tx, log_rx) = tokio::sync::mpsc::unbounded_channel::<String>();\n113\t    let _ = pigs_proxy::log::init_with_bridge(&proxy_config.log, log_tx);\n114\t\n115\t    let host = args.host.clone();\n116\t    let port = args.port;\n117\t\n118\t    eprintln!(\"[pigs] API: http://{host}:{port} (background)\");\n119\t    eprintln!(\"[pigs] CLI: pigs-cli REPL over HTTP (foreground)\");\n120\t    eprintln!(\"[pigs] /quit to exit, /ses api to view API logs\");\n121\t    eprintln!();\n122\t\n123\t    // 后台启动 API 服务器\n124\t    let api_handle = tokio::spawn(async move {\n125\t        if let Err(e) = pigs_proxy::serve(proxy_config).await {\n126\t            eprintln!(\"[pigs proxy] server error: {e:#}\");\n127\t        }\n128\t    });\n129\t\n130\t    // 构建 CLI 转发参数\n131\t    let mut full_args = vec![\"pigs\".to_string()];\n132\t    full_args.extend(args.cli_args.iter().cloned());\n133\t    if let Some(prompt) = &args.prompt {\n134\t        full_args.push(prompt.clone());\n135\t    }\n136\t\n137\t    // 前台运行 pigs-cli，通过 HTTP 连接 API 服务器（并接收 proxy 日志）\n138\t    let code = pigs_cli::run_cli_with_http_and_log(full_args, host, port, log_rx).await;\n139\t\n140\t    // CLI 退出 → 中止 API 服务器\n141\t    api_handle.abort();\n142\t    let _ = api_handle.await;\n143\t\n144\t    if code != std::process::ExitCode::SUCCESS {\n145\t        std::process::exit(1);\n146\t    }\n147\t    Ok(())\n148\t}\n149\t\n150\t/// 仅 API 模式：无 CLI，只启动相位 HTTP 服务器。\n151\tasync fn run_api_only(args: &Args) -> anyhow::Result<()> {\n152\t    let workspace = std::env::current_dir().unwrap_or_else(|_| PathBuf::from(\".\"));\n153\t    let proxy_config = ProxyConfig::load_layered(&workspace)\n154\t        .map_err(|e| anyhow::anyhow!(e.to_string()))?;\n155\t\n156\t    pigs_proxy::log::init(&proxy_config.log).map_err(|e| anyhow::anyhow!(e.to_string()))?;\n157\t\n158\t    eprintln!(\"[pigs] API-only: http://{}:{}\", args.host, args.port);\n159\t    eprintln!();\n160\t\n161\t    pigs_proxy::serve(proxy_config).await\n162\t}\n163\t\n164\tfn print_describe() {\n165\t    println!(\"pigs {}\", env!(\"CARGO_PKG_VERSION\"));\n166\t    println!(\"role: unique product binary\");\n167\t    println!(\"default (no args): CLI REPL (foreground, over HTTP) + phased API (background :3927)\");\n168\t    println!(\"  --api            API-only (no REPL, background daemon)\");\n169\t    println!(\"  \\\"prompt\\\"         start API + one-shot CLI turn over HTTP\");\n170\t    println!(\"core: protocol-native HttpPhasedRuntime + HTTP loopback transport\");\n171\t    println!(\"phases: pre -> executor -> post; markerless post -> post\");\n172\t    println!(\"markers: PIGEND | PIGFAIL (final non-empty line only)\");\n173\t    println!(\"tools: upstream agent execution + bounded in-memory continuation\");\n174\t    println!(\"cli: connects to local API via HTTP, real SSE streaming\");\n175\t    println!(\"docs: crates/pigs/docs/理解与规划.md\");\n176\t}\n177\t",
      "role": "tool",
      "tool_call_id": "call_88cde78748304a9e8e97e90f"
    },
    {
      "content": "1\t//! Pigs Agent — Core types and traits.\n2\t//!\n3\t//! This crate defines the fundamental abstractions shared across all other crates:\n4\t//! - Message model (`Message`, `ContentBlock`, `MessageRole`)\n5\t//! - Tool system (`ToolSpec`, `ToolHandler`, `ToolResult`, `ToolRegistry`)\n6\t//! - LLM API abstraction (`ApiClient`, `ApiRequest`, `ApiResponse`)\n7\t//! - Token usage tracking (`TokenUsage`)\n8\t\n9\tpub mod api;\n10\tpub mod message;\n11\tpub mod tool;\n12\tpub mod usage;\n13\t\n14\tpub use api::{\n15\t    ApiClient, ApiError, ApiFuture, ApiRequest, ApiResponse, StreamCallback, StreamEvent,\n16\t};\n17\tpub use message::{ContentBlock, Message, MessageRole};\n18\tpub use tool::{ToolError, ToolFuture, ToolHandler, ToolRegistry, ToolResult, ToolSpec};\n19\tpub use usage::TokenUsage;\n20\t",
      "role": "tool",
      "tool_call_id": "call_5a4baf013b864bccb5bc7928"
    }
  ],
