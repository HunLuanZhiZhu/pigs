      "content": "1\t//! Pigs API — 相位化 Agent 运行时模块库。\n2\t//! Pigs API — phased agent runtime modules.\n3\t//!\n4\t//! 本 crate 包含：\n5\t//! This crate contains:\n6\t//! - `phased_runtime` — Pre→Executor→Post 三相位 Agent 运行时\n7\t//!   Pre→Executor→Post phased agent runtime\n8\t//! - `phased_api_convert` — OpenAI 请求格式 → 相位运行时输入的转换层\n9\t//!   OpenAI request → phased runtime conversion\n10\t//! - `format` — 三种 API 格式的请求解析与响应构造\n11\t//!   Request parsing / response construction for three API formats\n12\t//! - `phased_markers` — 控制标记 PIGEND / PIGFAIL 的检测与清理\n13\t//!   Control marker PIGEND / PIGFAIL detection and stripping\n14\t//! - `phased_phase` — Phase 枚举\n15\t//!   Phase enum\n16\t//! - `phased_tools` — 相位运行时的工具注册表（复用 pigs-tools）\n17\t//!   Tool registry for phased runtime (reuses pigs-tools)\n18\t//! - `phased_prompts` — re-export pigs_prompts 的提示词函数\n19\t//!   Re-export of pigs_prompts prompt functions\n20\t//!\n21\t//! HTTP 服务器已移至 `pigs-proxy` crate。\n22\t//! HTTP server has been moved to the `pigs-proxy` crate.\n23\t\n24\t/// 三种 API 格式的请求解析与响应构造（CLI 本地运行时用）。\n25\t/// Request parsing and response construction for three API formats (CLI local runtime).\n26\tpub mod format;\n27\t\n28\t/// 协议原生请求保留、相位变更与响应抽取（HTTP 相位运行时用）。\n29\t/// Protocol-native request preservation, phase mutation, and output extraction (HTTP phase runtime).\n30\tpub mod protocol;\n31\t\n32\t/// OpenAI 请求 → 相位运行时输入的转换层（CLI 本地运行时用）。\n33\t/// OpenAI request → phased runtime conversion layer (CLI local runtime).\n34\tpub mod phased_api_convert;\n35\t\n36\t/// 相位化 Agent 运行时：Pre→Executor→Post + 标记路由（CLI 本地运行时用）。\n37\t/// Phased agent runtime: Pre→Executor→Post + marker routing (CLI local runtime).\n38\tpub mod phased_runtime;\n39\t\n40\t/// 协议原生 JSON 与 SSE 响应编码（HTTP 相位运行时用）。\n41\t/// Protocol-native JSON and SSE response encoding (HTTP phase runtime).\n42\tpub mod output;\n43\t\n44\t/// 协议原生 HTTP 相位运行时（Pre→Executor→Post + continuation）。\n45\t/// Protocol-native HTTP phase runtime (Pre→Executor→Post + continuation).\n46\tpub mod http_runtime;\n47\t\n48\t/// 有界内存的外部工具 continuation 存储。\n49\t/// Bounded in-memory external-tool continuations.\n50\tpub mod continuation;\n51\t\n52\t/// HTTP 相位运行时使用的传输抽象。\n53\t/// Transport abstraction used by the HTTP phase runtime.\n54\tpub mod transport;\n55\t\n56\t/// 纯 Pre → Executor → Post 状态机（无传输依赖）。\n57\t/// Pure Pre -> Executor -> Post state transitions (transport-free).\n58\tpub mod orchestration;\n59\t\n60\t/// Phase 枚举（Pre / Executor / Post）。\n61\t/// Phase enum (Pre / Executor / Post).\n62\tpub mod phased_phase;\n63\t\n64\t/// 控制标记 PIGEND / PIGFAIL 的检测与清理。\n65\t/// Control marker PIGEND / PIGFAIL detection and stripping.\n66\tpub mod phased_markers;\n67\t\n68\t/// 相位运行时的工具注册表。\n69\t/// Tool registry for the phased runtime.\n70\tpub mod phased_tools;\n71\t\n72\t/// 提示词 re-export（从 pigs_prompts）。\n73\t/// Prompt re-export (from pigs_prompts).\n74\tpub mod phased_prompts;\n75\t",
